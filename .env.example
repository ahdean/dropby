# =============================================================================
# dropby settings
# =============================================================================
# Copy this file to `.env.local` for local development. On Vercel, enter the
# same names and values under Project → Settings → Environment Variables.
# NEVER commit real values. `.env.local` is ignored by git.
# =============================================================================

# --- Supabase (required) -----------------------------------------------------
# Supabase dashboard → Project Settings → API (or "API Keys").

# The project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The PUBLISHABLE key (starts with "sb_publishable_"). On older projects this
# is called the "anon" key; that works too. Safe to expose to browsers.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The SECRET key (starts with "sb_secret_"). On older projects: "service_role".
# Bypasses all security rules. Server only. Never give it a NEXT_PUBLIC_ name.
# Used by dev login and by `npm run seed`.
SUPABASE_SECRET_KEY=

# --- Dev login (use until text messages are live, then switch off) -----------
# When "true", ANY phone number can sign in with the fixed code below and no
# text is sent. Set to "false" as soon as Twilio is working.
DEV_LOGIN_ENABLED=true
DEV_LOGIN_CODE=000000

# --- Site address (recommended) ----------------------------------------------
# Public address of the site with no trailing slash, e.g. https://dropby.vercel.app
# Used when building invite links. If empty, the address in the browser is used.
NEXT_PUBLIC_SITE_URL=

# --- Seed script only (optional) ---------------------------------------------
# Time zone the demo data is written in. Defaults to America/New_York.
# SEED_TZ=America/Los_Angeles
